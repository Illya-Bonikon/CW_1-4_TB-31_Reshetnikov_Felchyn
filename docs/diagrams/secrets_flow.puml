@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13
skinparam roundCorner 6
skinparam componentStyle rectangle

rectangle "Firebase Console\n(проєкт власника)" as Console
rectangle "Комп'ютер розробника" as Dev {
  [mobile-client/google-services.json\n(у .gitignore)] as GS
  [~/.config/remotepad/\nfirebase-service-account.json] as SA
}
rectangle "GitHub" as GH {
  [Репозиторій:\nлише код, без ключів] as Repo
  [Secrets: GOOGLE_SERVICES_JSON\n(base64)] as Sec
  [Actions: крок\n«Firebase config from secret»] as Act
}
rectangle "ПК із сервером" as Pc {
  [змінна REMOTEPAD_FCM_CREDENTIALS] as Env
}

Console --> GS : завантажити конфіг\nAndroid-застосунку
Console --> SA : згенерувати ключ\nсервісного акаунта
GS --> Sec : base64, вручну\nу налаштуваннях репозиторію
Sec --> Act : підставляється\nпід час збірки
Act --> Repo : не комітиться,\nіснує лише в раннері
SA --> Env : шлях до файлу
@enduml
