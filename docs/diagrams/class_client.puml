@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
hide empty members
left to right direction

package "ui" {
  class ConnectViewModel {
    +state : StateFlow<ConnectUiState>
    +savedHosts : StateFlow<List<HostPCProfile>>
    +search()
    +onPinChange(value : String)
    +connect(onSuccess : () -> Unit)
  }
  class ControlViewModel {
    +status : StateFlow<ConnectionStatus>
    +rttMs : StateFlow<Long?>
    +onDrag(dx : Float, dy : Float)
    +onScroll(dy : Float)
    +onTap(pointers : Int)
    +sendText(text : String)
    +pressKey(keyCode : Int, modifiers : Int)
    +runMacro(preset : MacroPreset)
    +disconnect()
  }
  class SettingsViewModel {
    +preference : StateFlow<UserPreference>
    +setSensitivity(value : Float)
    +setReverseScroll(enabled : Boolean)
  }
}

package "input" {
  class GestureTranslator {
    +preference : UserPreference
    +move(dx : Float, dy : Float) : Delta
    +scroll(dy : Float) : Int
    +tap(pointers : Int) : MouseButton
  }
  class MoveAccumulator {
    +add(delta : Delta)
    +drain() : Delta?
    +clear()
  }
  class KeyChordParser <<object>> {
    +parse(sequence : String) : KeyChord?
  }
  class PinValidator <<object>> {
    +sanitize(raw : String) : String
    +isComplete(pin : String) : Boolean
  }
}

package "network" {
  interface RemotePadConnection {
    +status : StateFlow<ConnectionStatus>
    +rttMs : StateFlow<Long?>
    +connect(target, pin, deviceName) : AuthResult
    +send(packet : InputEventPacket) : Boolean
    +disconnect()
  }
  class WebSocketConnection
  class RttTracker {
    +onPong(sentAtMs : Long, receivedAtMs : Long) : Long
  }
  interface HostDiscoverySource {
    +discover() : List<DiscoveredHost>
  }
  class CompositeHostDiscovery
  class UdpHostDiscovery
  class NsdHostDiscovery
}

package "data" {
  class SettingsRepository {
    +preferences : Flow<UserPreference>
    +update(transform)
  }
  class UserPreference <<data>> {
    sensitivity : Float
    acceleration : Boolean
    smoothingFactor : Float
    reverseScroll : Boolean
  }
  class ConnectionHistoryRepository {
    +savedHosts : Flow<List<HostPCProfile>>
    +recordLogin(...) : Long
    +endSession(now : Long)
    +forget(hostId : Long)
  }
  class MacroRepository {
    +macros : Flow<List<MacroPreset>>
    +save(title, keySequence, existing) : MacroPreset
    +recordUse(macroId : String)
    +delete(preset : MacroPreset)
  }
  class RemotePadDatabase {
    +hosts() : HostPCProfileDao
    +sessions() : DeviceSessionDao
    +macros() : MacroPresetDao
  }
}

package "push" {
  interface PushTokenProvider {
    +token() : String?
  }
  class FirebasePushTokenProvider
}

class AppContainer

AppContainer *-- ConnectionHistoryRepository
AppContainer *-- MacroRepository
AppContainer *-- SettingsRepository
AppContainer *-- RemotePadConnection
AppContainer *-- HostDiscoverySource
ConnectionHistoryRepository --> RemotePadDatabase
MacroRepository --> RemotePadDatabase
CompositeHostDiscovery ..|> HostDiscoverySource
UdpHostDiscovery ..|> HostDiscoverySource
NsdHostDiscovery ..|> HostDiscoverySource
CompositeHostDiscovery o-- HostDiscoverySource
FirebasePushTokenProvider ..|> PushTokenProvider
WebSocketConnection --> PushTokenProvider

WebSocketConnection ..|> RemotePadConnection
WebSocketConnection *-- RttTracker

ConnectViewModel --> AppContainer
ConnectViewModel ..> PinValidator
ControlViewModel --> AppContainer
ControlViewModel *-- GestureTranslator
ControlViewModel *-- MoveAccumulator
ControlViewModel ..> KeyChordParser
SettingsViewModel --> SettingsRepository
SettingsRepository ..> UserPreference
GestureTranslator --> UserPreference
@enduml
